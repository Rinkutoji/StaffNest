# Enable Rewrite Engine
RewriteEngine On

# Dynamic CORS: mirror the request Origin back only if it is in our allowlist
SetEnvIf Origin "^https://frontend-kappa-khaki-68\.vercel\.app$" CORS_ALLOW_ORIGIN=$0
SetEnvIf Origin "^http://localhost:5173$" CORS_ALLOW_ORIGIN=$0
SetEnvIf Origin "^http://localhost:3000$" CORS_ALLOW_ORIGIN=$0

# Intercept OPTIONS preflight requests directly at Apache level
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ - [R=200,L]

# Set CORS headers on ALL responses (including Apache error pages like 404/500)
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "%{CORS_ALLOW_ORIGIN}e" env=CORS_ALLOW_ORIGIN
    Header always set Access-Control-Allow-Credentials "true" env=CORS_ALLOW_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"
</IfModule>
